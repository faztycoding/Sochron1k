{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(AGENTS.md)",
      "Edit(AGENTS.override.md)",
      "Edit(CLAUDE.md)",
      "Edit(CLAUDE.local.md)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.claude/rules/**)",
      "Edit(**/.claude/commands/**)",
      "Edit(**/.agents/**)",
      "Edit(**/.codex/**)",
      "Edit(**/.github/**)",
      "Edit(**/tests/acceptance/**)",
      "Edit(**/tests/golden/**)",
      "Edit(**/tests/architecture/**)",
      "Edit(**/docs/HANDBOOK-CORE.md)",
      "Edit(**/scripts/controls/**)",
      "Edit(**/.gitattributes)",
      "Edit(**/research/registry/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.codex/auth.json)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock)",
      "Bash(uv lock *)",
      "Bash(uv pip install *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(winget *)",
      "Bash(choco *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking locked paths"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking command against project controls"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-locked-after.mjs\" --baseline",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-locked-after.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking locked paths after the command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-locked-after.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking locked paths after the failed command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
