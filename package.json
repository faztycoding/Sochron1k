{
  "name": "sochron1k",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @sochron1k/web",
    "check:compose:local": "bash scripts/check-compose-local.sh",
    "check:compose:static": "bash scripts/check-compose-static.sh",
    "check:db:local": "bash scripts/check-supabase-local.sh",
    "check:db:static": "bash scripts/check-supabase-static.sh",
    "check:web": "bash scripts/check-web.sh",
    "test:web": "npm run test --workspace @sochron1k/web",
    "typecheck": "npm run typecheck --workspace @sochron1k/web"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "supabase": "2.117.0"
  }
}
