# Runtime identity and safe local defaults
APP_ENV=development
APP_TIMEZONE=Asia/Bangkok
TRADING_MODE=demo
AUTO_TRADING_ENABLED=false

# Local API and web
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
SOCHRON_WEB_PORT=8080
# Optional native-bar archive: existing absolute owner-private directory, never a secret.
# Empty means monitoring-only; no durable history is claimed.
SOCHRON_CHART_HISTORY_DIR=
# Optional owner execution evidence: canonical path to an existing private
# ExecutionService SQLite journal. Empty keeps the read model disabled.
SOCHRON_EXECUTION_JOURNAL_PATH=
# Optional owner alert lifecycle journal: existing canonical absolute private
# directory. Empty keeps acknowledgement/resolution disabled and read-only.
SOCHRON_ALERT_LIFECYCLE_DIR=
# Optional authenticated MT5 execution bridge: owner-private config-file path.
# Empty keeps both inventory ingress and command transport disabled.
SOCHRON_EXECUTION_BRIDGE_CONFIG_FILE=
# Optional worker: private config-file path only; unset means DISABLED.
# The service credential belongs in a separate owner-private file, never here.
SOCHRON_SYNC_CONFIG_FILE=
# Optional coherent PA01 policy writer and producer config-file paths.
# Both files are owner-private; credentials remain in separate private files.
SOCHRON_POLICY_WRITER_CONFIG_FILE=
SOCHRON_PA01_CONFIG_FILE=
# Optional calendar News Gate collector config. The bearer credential remains in
# its separate owner-private file; unset means DISABLED.
SOCHRON_NEWS_GATE_CONFIG_FILE=
# Optional reproducible research-evaluation producer config. The immutable
# evidence bundle, durable state and service credential use separate private paths.
# Unset means DISABLED and produces no Supabase write.
SOCHRON_RESEARCH_EVALUATION_CONFIG_FILE=
# Optional owner-approved, non-secret Demo target decision record. The absolute
# owner-private path is validated; unset keeps owner decisions visibly missing.
SOCHRON_DEMO_READINESS_CONFIG_FILE=

# MT5 Demo account. Keep all secrets blank in this file.
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD
MT5_ACCOUNT_MODE=
MT5_MAGIC_NUMBER=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI candidate. It must not control risk or execution.
ZAI_API_KEY=
AI_NEWS_FILTER_ENABLED=false

# First-release risk policy
RISK_PER_TRADE_PCT=0.25
DAILY_LOSS_LIMIT_PCT=0.75
EXPERIMENT_LOSS_LIMIT_PCT=2.00
MAX_OPEN_POSITIONS=1
PRICE_STALE_SECONDS=5
ORDER_FLOW_ENABLED=false
