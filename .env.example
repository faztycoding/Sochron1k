# Variable NAMES only. Never put real values here, in prompts, logs, screenshots or commits.
# Copy to .env (gitignored) on the machine that runs the code. Agents must not read .env.
#
# MT5 Demo connection (proposed in D-001; used from SPIKE-001 onward).
# Preferred: log in to the Demo account inside the MT5 terminal yourself and leave the
# login fields empty. The MetaTrader5 Python package then attaches to the running terminal,
# so no password is needed in any config file.

# Optional: full path to terminal64.exe of the broker's MT5 build (if more than one is installed)
MT5_TERMINAL_PATH=

# Only if unattended login is approved later (restricted: runner machine only)
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
